# SecureAssist Langfuse secrets - TEMPLATE (no real values).
#
# 1. cp langfuse/.env.example langfuse/.env
# 2. replace every REPLACE_ME (README section F, Task 1 gives the exact openssl commands)
# 3. kubectl -n secureassist create secret generic secureassist-langfuse --from-env-file=langfuse/.env
#
# langfuse/.env is git-ignored - never commit it. No quotes, no spaces in values.

# ---- API keys: created in Langfuse on first start AND used by the backend ----
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME

# ---- Langfuse server secrets ----
NEXTAUTH_SECRET=REPLACE_ME
SALT=REPLACE_ME
# exactly 64 hex characters
ENCRYPTION_KEY=REPLACE_ME
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME

# ---- PostgreSQL (used by the langfuse-db Pod and by Langfuse) ----
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=langfuse
