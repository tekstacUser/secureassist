pipeline {
    agent any

    options {
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(
            name: 'RUN_SONAR',
            defaultValue: true,
            description: 'Run SonarQube analysis and enforce the quality gate'
        )

        string(
            name: 'SONARQUBE_SERVER',
            defaultValue: 'sonarqube',
            description: 'Name configured in Manage Jenkins > System > SonarQube servers'
        )

        string(
            name: 'SONAR_SCANNER_TOOL',
            defaultValue: 'SonarScanner',
            description: 'Name configured in Manage Jenkins > Tools'
        )

        booleanParam(
            name: 'SONAR_GATE_VIA_SCANNER',
            defaultValue: false,
            description: 'Use scanner-side gate waiting if no Jenkins webhook is configured'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy to Minikube and verify the deployment'
        )
    }

    environment {
        NS = 'secureassist'
        IMAGE_TAG = '1.0'

        FRONTEND_IMAGE = 'secureassist-frontend:1.0'
        BACKEND_IMAGE  = 'secureassist-backend:1.0'
        MCP_IMAGE      = 'secureassist-mcp:1.0'

        MINIKUBE_PROFILE = 'minikube'
        KUBECONFIG_FILE = '/etc/kubernetes/shared/config'

        PYTHONDONTWRITEBYTECODE = '1'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    git log -1 --oneline

                    test -f README.md
                    test -f cicd/Jenkinsfile
                    test -d app/frontend
                    test -d app/backend
                    test -d mcp_server
                    test -d langfuse
                    test -d k8s

                    mkdir -p reports
                '''
            }
        }

        stage('2. Environment and tool checks') {
            steps {
                sh '''
                    set -eu

                    echo "Checking execution identities"
                    id
                    sudo -n -u tekuser id

                    echo "Checking source workspace access"
                    test -r app/frontend/Dockerfile
                    test -r app/backend/Dockerfile
                    test -r mcp_server/Dockerfile

                    echo "Checking Docker as tekuser"
                    sudo -n -u tekuser docker info \
                        > reports/docker-info.txt 2>&1 || {
                            cat reports/docker-info.txt
                            echo "FAIL: Docker is unavailable to tekuser"
                            exit 1
                        }

                    echo "Checking Minikube as tekuser"
                    sudo -n -u tekuser minikube \
                        -p "$MINIKUBE_PROFILE" status \
                        > reports/minikube-status.txt 2>&1 || {
                            cat reports/minikube-status.txt
                            echo "FAIL: Minikube is not ready"
                            exit 1
                        }

                    echo "Checking Kubernetes access"
                    test -r "$KUBECONFIG_FILE"

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        cluster-info \
                        > reports/cluster-info.txt 2>&1 || {
                            cat reports/cluster-info.txt
                            echo "FAIL: tekuser cannot access Kubernetes"
                            exit 1
                        }

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        get nodes \
                        > reports/kubernetes-nodes.txt

                    cat reports/minikube-status.txt
                    cat reports/cluster-info.txt
                    cat reports/kubernetes-nodes.txt

                    echo "Environment checks PASSED"
                '''
            }
        }

        stage('3. Code checks') {
            steps {
                sh '''
                    set -eu

                    find app mcp_server \
                        -name '*.py' \
                        -not -path '*/__pycache__/*' \
                        -print | sort > reports/python-files.txt

                    test -s reports/python-files.txt

                    PYTHONPYCACHEPREFIX=reports/.pycache \
                        python3 -m py_compile \
                        $(cat reports/python-files.txt)

                    rm -rf reports/.pycache

                    echo "Python syntax checks PASSED" \
                        | tee reports/code-checks.txt

                    echo "Checking backend for prohibited execution primitives"

                    if grep -nE \
                        '^[[:space:]]*(import|from)[[:space:]]+(subprocess|pty)([[:space:]]|$)|os[.]system[(]|os[.]popen[(]|(^|[^A-Za-z_])eval[(]|(^|[^A-Za-z_])exec[(]' \
                        app/backend/*.py; then
                        echo "FAIL: Prohibited execution primitive found"
                        exit 1
                    fi

                    echo "No prohibited execution primitives found" \
                        | tee -a reports/code-checks.txt

                    echo "Scanning for possible committed secrets"

                    leaks=$(grep -RnE \
                        '(sk-lf-|pk-lf-)[A-Za-z0-9]{8,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY' \
                        --exclude-dir=.git \
                        --exclude-dir=reports \
                        --exclude-dir=.scannerwork \
                        --exclude='.env' \
                        --exclude='*.example' \
                        . | grep -v REPLACE_ME || true)

                    if [ -n "$leaks" ]; then
                        echo "$leaks"
                        echo "FAIL: Possible secret detected"
                        exit 1
                    fi

                    echo "Secret pattern check PASSED" \
                        | tee -a reports/code-checks.txt
                '''
            }
        }

        stage('4. SonarQube analysis') {
            when {
                expression { return params.RUN_SONAR }
            }

            steps {
                script {
                    def scannerHome = tool(params.SONAR_SCANNER_TOOL)
                    env.SONAR_SCANNER = "${scannerHome}/bin/sonar-scanner"
                }

                withSonarQubeEnv(params.SONARQUBE_SERVER) {
                    sh '''
                        set -eu

                        curl -fsS -m 10 \
                            "$SONAR_HOST_URL/api/system/status" \
                            | tee reports/sonar-server-status.json

                        test -x "$SONAR_SCANNER" || {
                            echo "FAIL: SonarScanner not found"
                            exit 1
                        }

                        GATE_ARGS=""

                        if [ "$SONAR_GATE_VIA_SCANNER" = "true" ]; then
                            GATE_ARGS="-Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=300"
                        fi

                        set +e
                        SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                            "$SONAR_SCANNER" \
                            -Dsonar.host.url="$SONAR_HOST_URL" \
                            -Dsonar.projectVersion="$IMAGE_TAG-$BUILD_NUMBER" \
                            $GATE_ARGS \
                            > reports/sonar-scanner-output.txt 2>&1
                        rc=$?
                        set -e

                        cat reports/sonar-scanner-output.txt

                        if [ -f .scannerwork/report-task.txt ]; then
                            cp .scannerwork/report-task.txt \
                                reports/sonar-report-task.txt
                        fi

                        if [ "$rc" -ne 0 ]; then
                            echo "FAIL: SonarQube analysis or scanner-side gate failed"
                            exit "$rc"
                        fi

                        echo "SonarQube analysis completed"
                    '''
                }
            }
        }

        stage('5. SonarQube quality gate') {
            when {
                expression {
                    return params.RUN_SONAR &&
                        !params.SONAR_GATE_VIA_SCANNER
                }
            }

            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        writeFile(
                            file: 'reports/sonar-quality-gate.txt',
                            text: "quality_gate=${qg.status}\nbuild=${env.BUILD_NUMBER}\ntime=${new Date().format("yyyy-MM-dd'T'HH:mm:ssZ")}\n"
                        )

                        if (qg.status != 'OK') {
                            error("SonarQube quality gate failed: ${qg.status}")
                        }

                        echo "SonarQube quality gate: ${qg.status}"
                    }
                }
            }
        }

        stage('6. Build Docker images as tekuser') {
            steps {
                sh '''
                    set -eu

                    echo "Building frontend"
                    sudo -n -u tekuser docker build \
                        -t "$FRONTEND_IMAGE" \
                        -f app/frontend/Dockerfile . \
                        > reports/frontend-build.txt 2>&1 || {
                            cat reports/frontend-build.txt
                            exit 1
                        }

                    echo "Building backend"
                    sudo -n -u tekuser docker build \
                        -t "$BACKEND_IMAGE" \
                        -f app/backend/Dockerfile . \
                        > reports/backend-build.txt 2>&1 || {
                            cat reports/backend-build.txt
                            exit 1
                        }

                    echo "Building MCP server"
                    sudo -n -u tekuser docker build \
                        -t "$MCP_IMAGE" \
                        -f mcp_server/Dockerfile . \
                        > reports/mcp-build.txt 2>&1 || {
                            cat reports/mcp-build.txt
                            exit 1
                        }

                    sudo -n -u tekuser docker image inspect \
                        "$FRONTEND_IMAGE" "$BACKEND_IMAGE" "$MCP_IMAGE" \
                        --format '{{.RepoTags}}' \
                        > reports/images.txt

                    cat reports/images.txt
                '''
            }
        }

        stage('7. Load images into Minikube as tekuser') {
            steps {
                sh '''
                    set -eu

                    for image in "$FRONTEND_IMAGE" "$BACKEND_IMAGE" "$MCP_IMAGE"; do
                        echo "Loading $image"

                        sudo -n -u tekuser minikube \
                            -p "$MINIKUBE_PROFILE" image load "$image"
                    done

                    sudo -n -u tekuser minikube \
                        -p "$MINIKUBE_PROFILE" image ls \
                        > reports/minikube-images.txt

                    cat reports/minikube-images.txt
                '''
            }
        }

        stage('8. Validate Kubernetes manifests as tekuser') {
            steps {
                sh '''
                    set -eu

                    echo "Checking all manifests client-side"

                    for f in \
                        k8s/namespace.yaml \
                        k8s/langfuse-db-deployment.yaml \
                        k8s/langfuse-db-service.yaml \
                        k8s/langfuse-deployment.yaml \
                        k8s/langfuse-service.yaml \
                        k8s/mcp-deployment.yaml \
                        k8s/mcp-service.yaml \
                        k8s/backend-deployment.yaml \
                        k8s/backend-service.yaml \
                        k8s/frontend-deployment.yaml \
                        k8s/frontend-service.yaml
                    do
                        kubectl apply --dry-run=client -f "$f" \
                            >> reports/manifest-validation.txt
                        echo "CLIENT OK: $f" \
                            | tee -a reports/manifest-validation.txt
                    done

                    echo "Checking Kubernetes server-side validation"

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        apply --dry-run=server -f k8s/namespace.yaml \
                        > reports/server-validation.txt

                    if sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        get namespace "$NS" >/dev/null 2>&1; then

                        for f in \
                            k8s/langfuse-db-deployment.yaml \
                            k8s/langfuse-db-service.yaml \
                            k8s/langfuse-deployment.yaml \
                            k8s/langfuse-service.yaml \
                            k8s/mcp-deployment.yaml \
                            k8s/mcp-service.yaml \
                            k8s/backend-deployment.yaml \
                            k8s/backend-service.yaml \
                            k8s/frontend-deployment.yaml \
                            k8s/frontend-service.yaml
                        do
                            sudo -n -u tekuser kubectl \
                                --kubeconfig="$KUBECONFIG_FILE" \
                                apply --dry-run=server -f "$f" \
                                >> reports/server-validation.txt
                            echo "SERVER OK: $f" \
                                | tee -a reports/server-validation.txt
                        done
                    else
                        echo "Namespace does not exist yet; namespaced server validation is deferred until deployment." \
                            | tee -a reports/server-validation.txt
                    fi

                    cat reports/manifest-validation.txt
                    cat reports/server-validation.txt
                '''
            }
        }

        stage('9. Deploy to Minikube as tekuser') {
            when {
                expression { return params.DEPLOY }
            }

            steps {
                sh '''
                    set -eu

                    K="sudo -n -u tekuser kubectl"

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        apply -f k8s/namespace.yaml

                    # The Langfuse credentials must be provisioned
                    # separately. Never commit secrets into Git.
                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" get secret secureassist-langfuse \
                        >/dev/null || {
                            echo "FAIL: Secret secureassist-langfuse is missing."
                            echo "Create it securely before deploying."
                            exit 1
                        }

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        apply \
                        -f k8s/langfuse-db-deployment.yaml \
                        -f k8s/langfuse-db-service.yaml \
                        -f k8s/langfuse-deployment.yaml \
                        -f k8s/langfuse-service.yaml \
                        -f k8s/mcp-deployment.yaml \
                        -f k8s/mcp-service.yaml \
                        -f k8s/backend-deployment.yaml \
                        -f k8s/backend-service.yaml \
                        -f k8s/frontend-deployment.yaml \
                        -f k8s/frontend-service.yaml

                    for d in langfuse-db langfuse mcp backend frontend; do
                        sudo -n -u tekuser kubectl \
                            --kubeconfig="$KUBECONFIG_FILE" \
                            -n "$NS" rollout status \
                            "deployment/secureassist-$d" \
                            --timeout=420s
                    done

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" get deploy,pods,svc,pvc \
                        > reports/k8s-status.txt

                    cat reports/k8s-status.txt
                '''
            }
        }

        stage('10. Deployment and health checks') {
            when {
                expression { return params.DEPLOY }
            }

            steps {
                sh '''
                    set -eu

                    K="sudo -n -u tekuser kubectl"

                    # Confirm that all deployments have an available replica.
                    for d in langfuse-db langfuse mcp backend frontend; do
                        sudo -n -u tekuser kubectl \
                            --kubeconfig="$KUBECONFIG_FILE" \
                            -n "$NS" rollout status \
                            "deployment/secureassist-$d" \
                            --timeout=120s
                    done

                    # Check local health endpoints inside each application pod.
                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" exec deployment/secureassist-frontend -- \
                        python -c \
                        'import urllib.request; r=urllib.request.urlopen("http://127.0.0.1:8091/health",timeout=10); print("frontend HTTP",r.status); assert r.status==200' \
                        > reports/frontend-health.txt

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" exec deployment/secureassist-backend -- \
                        python -c \
                        'import urllib.request; r=urllib.request.urlopen("http://127.0.0.1:8092/health",timeout=10); print("backend HTTP",r.status); assert r.status==200' \
                        > reports/backend-health.txt

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" exec deployment/secureassist-backend -- \
                        python -c \
                        'import urllib.request; r=urllib.request.urlopen("http://127.0.0.1:8092/ready?deep=true",timeout=20); print("backend deep readiness HTTP",r.status); print(r.read().decode()); assert r.status==200' \
                        > reports/backend-readiness.txt

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" exec deployment/secureassist-mcp -- \
                        python -c \
                        'import urllib.request; r=urllib.request.urlopen("http://127.0.0.1:8093/health",timeout=10); print("MCP HTTP",r.status); assert r.status==200' \
                        > reports/mcp-health.txt

                    # Check Langfuse from inside its Node.js container.
                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" exec deployment/secureassist-langfuse -- \
                        node -e \
                        'require("http").get("http://127.0.0.1:3031/api/public/health",r=>{console.log("Langfuse HTTP",r.statusCode);process.exit(r.statusCode===200?0:1)}).on("error",e=>{console.error(e);process.exit(1)})' \
                        > reports/langfuse-health.txt

                    sudo -n -u tekuser kubectl \
                        --kubeconfig="$KUBECONFIG_FILE" \
                        -n "$NS" get deploy,pods,svc,pvc \
                        > reports/verification.txt

                    cat reports/frontend-health.txt
                    cat reports/backend-health.txt
                    cat reports/backend-readiness.txt
                    cat reports/mcp-health.txt
                    cat reports/langfuse-health.txt
                    cat reports/verification.txt

                    echo "All deployment health checks PASSED"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/**',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }

        success {
            echo 'SecureAssist pipeline PASSED. Evidence is archived under Build Artifacts.'
        }

        failure {
            echo 'SecureAssist pipeline FAILED. Inspect the first failed stage and archived reports.'
        }
    }
}
