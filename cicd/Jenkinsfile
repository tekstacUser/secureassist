pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'RUN_SONAR',
            defaultValue: true,
            description: 'Run SonarQube analysis and quality gate'
        )

        booleanParam(
            name: 'SONAR_GATE_VIA_SCANNER',
            defaultValue: false,
            description: 'Wait for the quality gate inside SonarScanner instead of using Jenkins waitForQualityGate'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Build images, load them into Minikube, deploy, and verify'
        )

        string(
            name: 'SONARQUBE_SERVER',
            defaultValue: 'sonarqube',
            description: 'Exact SonarQube server name configured in Jenkins'
        )

        string(
            name: 'SONAR_SCANNER_TOOL',
            defaultValue: 'SonarScanner',
            description: 'Exact SonarScanner installation name configured in Jenkins'
        )
    }

    environment {
        NS = 'secureassist'
        IMAGE_TAG = '1.0'

        FRONTEND_IMAGE = 'secureassist-frontend:1.0'
        BACKEND_IMAGE  = 'secureassist-backend:1.0'
        MCP_IMAGE      = 'secureassist-mcp:1.0'

        MINIKUBE_PROFILE = 'minikube'
        MINIKUBE_HOME = '/home/tekuser/.minikube'
        KUBECONFIG = '/etc/kubernetes/shared/config'

        // Jenkins executes commands as jenkins.
        // HOME is set to tekuser only inside shell steps that need
        // the existing Minikube profile.
        PYTHONDONTWRITEBYTECODE = '1'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm

                sh '''
                    set -eu
                    mkdir -p reports

                    echo "=== Checkout verification ==="
                    git log -1 --oneline

                    test -f README.md
                    test -f cicd/Jenkinsfile
                    test -d app/frontend
                    test -d app/backend
                    test -d mcp_server
                    test -d langfuse
                    test -d k8s

                    echo "Checkout: PASS"
                '''
            }
        }

        stage('2. Environment and tool checks') {
            steps {
                sh '''
                    set -eu

                    export HOME=/home/tekuser
                    export MINIKUBE_HOME=/home/tekuser/.minikube
                    export KUBECONFIG=/etc/kubernetes/shared/config

                    mkdir -p reports

                    echo "=== Jenkins execution identity ==="
                    id | tee reports/execution-identity.txt

                    test "$(id -un)" = "jenkins"

                    echo "=== Docker ==="
                    docker --version
                    docker info > reports/docker-info.txt 2>&1 || {
                        cat reports/docker-info.txt
                        exit 1
                    }
                    echo "Docker access: PASS"

                    echo "=== Minikube ==="
                    minikube -p minikube status |
                        tee reports/minikube-status.txt
                    echo "Minikube access: PASS"

                    echo "=== Kubernetes ==="
                    kubectl get nodes |
                        tee reports/kubernetes-nodes.txt

                    kubectl -n "$NS" get pods |
                        tee reports/kubernetes-pods-before.txt

                    echo "Kubernetes access: PASS"
                '''
            }
        }

        stage('3. Code checks') {
            steps {
                sh '''
                    set -eu

                    echo "=== Python syntax checks ==="
                    python3 --version
                    python3 -m compileall -q app mcp_server

                    echo "=== Git whitespace checks ==="
                    git diff --check

                    echo "=== Required Dockerfiles ==="
                    test -f app/frontend/Dockerfile
                    test -f app/backend/Dockerfile
                    test -f mcp_server/Dockerfile

                    echo "=== Kubernetes manifests ==="
                    test -f k8s/namespace.yaml
                    test -f k8s/frontend-deployment.yaml
                    test -f k8s/frontend-service.yaml
                    test -f k8s/backend-deployment.yaml
                    test -f k8s/backend-service.yaml
                    test -f k8s/mcp-deployment.yaml
                    test -f k8s/mcp-service.yaml
                    test -f k8s/langfuse-deployment.yaml
                    test -f k8s/langfuse-service.yaml
                    test -f k8s/langfuse-db-deployment.yaml
                    test -f k8s/langfuse-db-service.yaml

                    echo "Code and required-file checks: PASS"
                '''
            }
        }

        stage('4. SonarQube analysis') {
            when {
                expression { params.RUN_SONAR }
            }
            steps {
                script {
                    def scannerHome = tool(
                        name: params.SONAR_SCANNER_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    def gateWaitFlag = params.SONAR_GATE_VIA_SCANNER
                        ? '-Dsonar.qualitygate.wait=true'
                        : ''

                    withSonarQubeEnv(params.SONARQUBE_SERVER) {
                        sh """
                            set -eu

                            export HOME=/home/tekuser
                            export MINIKUBE_HOME=/home/tekuser/.minikube
                            export KUBECONFIG=/etc/kubernetes/shared/config

                            if [ -z "\${SONAR_AUTH_TOKEN:-}" ]; then
                                echo "ERROR: SONAR_AUTH_TOKEN was not supplied by the Jenkins SonarQube configuration."
                                exit 1
                            fi

                            export SONAR_TOKEN="\${SONAR_AUTH_TOKEN}"

                            test -x "${scannerHome}/bin/sonar-scanner"

                            echo "Running SonarQube analysis"

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectBaseDir=. \
                                ${gateWaitFlag}
                        """
                    }
                }
            }
        }

        stage('5. SonarQube quality gate') {
            when {
                expression {
                    params.RUN_SONAR && !params.SONAR_GATE_VIA_SCANNER
                }
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate(
                            abortPipeline: true
                        )

                        echo "SonarQube quality gate: ${qualityGate.status}"

                        if (qualityGate.status != 'OK') {
                            error(
                                "SonarQube quality gate failed: ${qualityGate.status}"
                            )
                        }
                    }
                }
            }
        }

        stage('6. Build Docker images as jenkins') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                sh '''
                    set -eu
        
                    echo "=== Build frontend ==="
                    docker build -t "$FRONTEND_IMAGE" app/frontend
        
                    echo "=== Build backend ==="
                    docker build -t "$BACKEND_IMAGE" app/backend
        
                    echo "=== Build MCP server ==="
                    docker build -t "$MCP_IMAGE" mcp_server
        
                    echo "=== Verify built images ==="
                    docker image inspect "$FRONTEND_IMAGE" >/dev/null
                    docker image inspect "$BACKEND_IMAGE" >/dev/null
                    docker image inspect "$MCP_IMAGE" >/dev/null
        
                    docker images
                    echo "Docker image builds: PASS"
                '''
            }
        }

        stage('7. Load images into Minikube as tekuser') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                sh '''
                    set -eu

                    mkdir -p reports

                    echo "=== Load and verify images as tekuser ==="

                    if sudo -u tekuser /usr/local/bin/secureassist-ci \
                        > reports/minikube-images.txt 2>&1; then
                        cat reports/minikube-images.txt
                    else
                        cat reports/minikube-images.txt
                        echo "ERROR: Minikube image loading failed."
                        exit 1
                    fi

                    grep -F "$FRONTEND_IMAGE" reports/minikube-images.txt
                    grep -F "$BACKEND_IMAGE" reports/minikube-images.txt
                    grep -F "$MCP_IMAGE" reports/minikube-images.txt

                    echo "Minikube image loading: PASS"
                '''
            }
        }

        stage('8. Validate Kubernetes manifests as jenkins') {
            steps {
                sh '''
                    set -eu

                    export HOME=/home/tekuser
                    export MINIKUBE_HOME=/home/tekuser/.minikube
                    export KUBECONFIG=/etc/kubernetes/shared/config

                    echo "=== Validate Kubernetes YAML manifests ==="

                    for file in k8s/*.yaml; do
                        echo "Validating $file"
                        kubectl apply --dry-run=client -f "$file"
                    done

                    echo "Client-side manifest validation: PASS"
                '''
            }
        }

        stage('9. Deploy to Minikube as jenkins') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                sh '''
                    set -eu

                    export HOME=/home/tekuser
                    export MINIKUBE_HOME=/home/tekuser/.minikube
                    export KUBECONFIG=/etc/kubernetes/shared/config

                    echo "=== Apply namespace ==="
                    kubectl apply -f k8s/namespace.yaml

                    echo "=== Check required Langfuse secret ==="
                    if ! kubectl -n "$NS" get secret secureassist-langfuse >/dev/null 2>&1; then
                        echo "ERROR: Secret secureassist-langfuse is missing."
                        echo "Create it securely before deploying. Do not commit credentials to Git."
                        exit 1
                    fi

                    echo "=== Server-side manifest validation ==="
                    for file in k8s/*.yaml; do
                        echo "Validating $file"
                        kubectl apply --dry-run=server -f "$file"
                    done

                    echo "=== Apply application manifests ==="
                    kubectl apply -f k8s/

                    echo "=== Wait for deployments ==="
                    kubectl -n "$NS" rollout status \
                        deployment/secureassist-langfuse-db \
                        --timeout=240s

                    kubectl -n "$NS" rollout status \
                        deployment/secureassist-langfuse \
                        --timeout=240s

                    kubectl -n "$NS" rollout status \
                        deployment/secureassist-mcp \
                        --timeout=240s

                    kubectl -n "$NS" rollout status \
                        deployment/secureassist-backend \
                        --timeout=240s

                    kubectl -n "$NS" rollout status \
                        deployment/secureassist-frontend \
                        --timeout=240s

                    kubectl -n "$NS" get deployments
                    kubectl -n "$NS" get pods
                    kubectl -n "$NS" get services

                    echo "Deployment: PASS"
                '''
            }
        }

        stage('10. Deployment and health checks') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                sh '''
                    set -eu

                    export HOME=/home/tekuser
                    export MINIKUBE_HOME=/home/tekuser/.minikube
                    export KUBECONFIG=/etc/kubernetes/shared/config

                    mkdir -p reports

                    echo "=== Frontend health ==="
                    kubectl -n "$NS" exec deployment/secureassist-frontend -- \
                        python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=10); print(r.read().decode()); assert r.status == 200"

                    echo "=== Backend health ==="
                    kubectl -n "$NS" exec deployment/secureassist-backend -- \
                        python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8092/health', timeout=10); print(r.read().decode()); assert r.status == 200"

                    echo "=== Backend deep readiness ==="
                    kubectl -n "$NS" exec deployment/secureassist-backend -- \
                        python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8092/ready?deep=true', timeout=20); print(r.read().decode()); assert r.status == 200"

                    echo "=== MCP server health ==="
                    kubectl -n "$NS" exec deployment/secureassist-mcp -- \
                        python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8093/health', timeout=10); print(r.read().decode()); assert r.status == 200"

                    echo "=== Langfuse health ==="
                    kubectl -n "$NS" exec deployment/secureassist-langfuse -- \
                        node -e "fetch('http://127.0.0.1:3031/api/public/health').then(async r => { const body = await r.text(); console.log(body); if (!r.ok) process.exit(1); }).catch(e => { console.error(e); process.exit(1); })"

                    echo "=== Final deployment status ==="
                    kubectl -n "$NS" get deployments
                    kubectl -n "$NS" get pods
                    kubectl -n "$NS" get services

                    echo "All deployment health checks: PASS"
                '''
            }
        }

        stage('11. Start port-forwards and verify application') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                sh '''
                    set -eu
                    mkdir -p reports
        
                    echo "=== Clear ports 8091, 8097, 8093 and 3031 ==="
        
                    if ! command -v fuser >/dev/null 2>&1; then
                        echo "ERROR: fuser is required to clear ports."
                        exit 1
                    fi
        
                    for port in 8091 8097 8093 3031; do
                        echo "Checking port $port"
                        fuser -k "$port/tcp" 2>/dev/null || true
                    done
        
                    sleep 2
        
                    echo "=== Configure Minikube access ==="
                    export HOME=/home/tekuser
                    export MINIKUBE_HOME=/home/tekuser/.minikube
                    export KUBECONFIG=/etc/kubernetes/shared/config
        
                    echo "=== Start frontend on 8091 (external access) ==="
                    nohup kubectl -n secureassist port-forward \
                        --address 0.0.0.0 \
                        svc/secureassist-frontend 8091:8091 \
                        > reports/forward-frontend.log 2>&1 < /dev/null &
        
                    echo "=== Start backend on 8097 (VM-local only) ==="
                    nohup kubectl -n secureassist port-forward \
                        --address 127.0.0.1 \
                        svc/secureassist-backend 8097:8092 \
                        > reports/forward-backend.log 2>&1 < /dev/null &
        
                    echo "=== Start MCP on 8093 (VM-local only) ==="
                    nohup kubectl -n secureassist port-forward \
                        --address 127.0.0.1 \
                        svc/secureassist-mcp 8093:8093 \
                        > reports/forward-mcp.log 2>&1 < /dev/null &
        
                    echo "=== Start Langfuse on 3031 (external access) ==="
                    nohup kubectl -n secureassist port-forward \
                        --address 0.0.0.0 \
                        svc/secureassist-langfuse 3031:3031 \
                        > reports/forward-langfuse.log 2>&1 < /dev/null &
        
                    echo "=== Wait for port-forwards ==="
                    sleep 5
        
                    echo "=== Verify frontend ==="
                    curl --retry 5 --retry-delay 2 --retry-connrefused \
                        -fsS http://127.0.0.1:8091/health
                    echo
        
                    echo "=== Verify backend ==="
                    curl --retry 5 --retry-delay 2 --retry-connrefused \
                        -fsS http://127.0.0.1:8097/health
                    echo
        
                    echo "=== Verify backend deep readiness ==="
                    curl --retry 5 --retry-delay 2 --retry-connrefused \
                        -fsS 'http://127.0.0.1:8097/ready?deep=true' \
                        | python3 -m json.tool
        
                    echo "=== Verify MCP ==="
                    curl --retry 5 --retry-delay 2 --retry-connrefused \
                        -fsS http://127.0.0.1:8093/health
                    echo
        
                    echo "=== Verify Langfuse ==="
                    curl --retry 5 --retry-delay 2 --retry-connrefused \
                        -fsS http://127.0.0.1:3031/api/public/health
                    echo
        
                    echo "=== Port-forward processes ==="
                    pgrep -af '[k]ubectl.*port-forward' || true
        
                    echo "Port-forward setup and health checks: PASS"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/**',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'SecureAssist pipeline completed successfully.'
        }

        failure {
            echo 'SecureAssist pipeline FAILED. Inspect the first failed stage and archived reports.'
        }
    }
}
