// SecureAssist CI/CD Pipeline
//
// Jenkins job: SecureAssist
// Repository: https://github.com/tekstacUser/secureassist.git
// Script Path: cicd/Jenkinsfile
//
// Jenkins controller/executor: jenkins
// Docker builds and Minikube operations: tekuser
//
// Prerequisite:
// /usr/local/bin/secureassist-ci must be installed and executable.
// Jenkins must have passwordless permission to execute ONLY this helper
// as tekuser. Do not grant unrestricted sudo permissions.
//
// Helper actions:
// check, build, load, validate, deploy, verify
//
// Existing Minikube cluster and credentials remain owned by tekuser.

pipeline {
    agent any

    options {
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(
            name: 'RUN_SONAR',
            defaultValue: true,
            description: 'Run SonarQube analysis and enforce the quality gate'
        )

        string(
            name: 'SONARQUBE_SERVER',
            defaultValue: 'sonarqube',
            description: 'Name configured in Manage Jenkins > System > SonarQube servers'
        )

        string(
            name: 'SONAR_SCANNER_TOOL',
            defaultValue: 'SonarScanner',
            description: 'Name configured in Manage Jenkins > Tools'
        )

        booleanParam(
            name: 'SONAR_GATE_VIA_SCANNER',
            defaultValue: false,
            description: 'Enable if SonarQube has no Jenkins webhook'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy to Minikube and run verification'
        )
    }

    environment {
        NS = 'secureassist'
        IMAGE_TAG = '1.0'
        POSTGRES_IMAGE = 'postgres:16.4-alpine'
        PYTHONDONTWRITEBYTECODE = '1'
        SECUREASSIST_HELPER = '/usr/local/bin/secureassist-ci'
    }

    stages {

        stage('1. Checkout') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    git log -1 --oneline || true

                    test -f README.md
                    test -f cicd/Jenkinsfile
                    test -d app/frontend
                    test -d app/backend
                    test -d mcp_server
                    test -d langfuse
                    test -d k8s

                    mkdir -p reports
                '''
            }
        }

        stage('2. Environment and tool checks') {
            steps {
                sh '''
                    set -eu

                    test -x "$SECUREASSIST_HELPER" || {
                        echo "FAIL: $SECUREASSIST_HELPER is missing or not executable"
                        exit 1
                    }

                    # Verify the narrowly scoped privilege works without a prompt.
                    sudo -n -u tekuser \
                        "$SECUREASSIST_HELPER" check "$WORKSPACE" \
                        > reports/capabilities.txt 2>&1 || {
                            cat reports/capabilities.txt
                            echo "FAIL: tekuser environment checks failed"
                            exit 1
                        }

                    cat reports/capabilities.txt
                '''
            }
        }

        stage('3. Code checks') {
            steps {
                sh '''
                    set -eu

                    files=$(find app mcp_server \
                        -name '*.py' \
                        -not -path '*/__pycache__/*' | sort)

                    test -n "$files"

                    echo "Python syntax check:"
                    echo "$files"

                    PYTHONPYCACHEPREFIX=reports/.pycache \
                        python3 -m py_compile $files

                    rm -rf reports/.pycache

                    echo "syntax OK: $(echo "$files" | wc -l) files" \
                        | tee reports/code-checks.txt

                    echo "Checking backend for unsafe execution primitives"

                    if grep -nE \
                        '^[[:space:]]*(import|from)[[:space:]]+(subprocess|pty)([[:space:]]|$)|os[.]system[(]|os[.]popen[(]|(^|[^A-Za-z_])eval[(]|(^|[^A-Za-z_])exec[(]' \
                        app/backend/*.py; then
                        echo "FAIL: execution primitive found in app/backend"
                        exit 1
                    fi

                    echo "No prohibited execution primitives found" \
                        | tee -a reports/code-checks.txt

                    echo "Scanning committed source for possible secrets"

                    leaks=$(grep -RnE \
                        '(sk-lf-|pk-lf-)[A-Za-z0-9]{8,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY' \
                        --exclude-dir=.git \
                        --exclude-dir=reports \
                        --exclude-dir=.scannerwork \
                        --exclude='.env' \
                        --exclude='*.example' \
                        . | grep -v REPLACE_ME || true)

                    if [ -n "$leaks" ]; then
                        echo "$leaks"
                        echo "FAIL: possible secret in source"
                        exit 1
                    fi

                    echo "No matching committed secrets found" \
                        | tee -a reports/code-checks.txt
                '''
            }
        }

        stage('4. SonarQube analysis') {
            when {
                expression { return params.RUN_SONAR }
            }

            steps {
                script {
                    env.SONAR_SCANNER =
                        "${tool(params.SONAR_SCANNER_TOOL)}/bin/sonar-scanner"

                    env.GATE_ARGS = params.SONAR_GATE_VIA_SCANNER
                        ? '-Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=300'
                        : ''
                }

                withSonarQubeEnv(params.SONARQUBE_SERVER) {
                    sh '''
                        set -eu

                        curl -fsS -m 10 \
                            "$SONAR_HOST_URL/api/system/status" \
                            | tee reports/sonar-server-status.json

                        echo

                        set +e

                        SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                            "$SONAR_SCANNER" \
                            -Dsonar.host.url="$SONAR_HOST_URL" \
                            -Dsonar.projectVersion="$IMAGE_TAG-$BUILD_NUMBER" \
                            $GATE_ARGS \
                            > reports/sonar-scanner-output.txt 2>&1

                        rc=$?

                        set -e

                        cat reports/sonar-scanner-output.txt

                        if [ -f .scannerwork/report-task.txt ]; then
                            cp .scannerwork/report-task.txt \
                                reports/sonar-report-task.txt
                        fi

                        if [ "$rc" -ne 0 ]; then
                            echo "FAIL: SonarQube analysis failed with exit $rc"
                            exit "$rc"
                        fi
                    '''
                }
            }
        }

        stage('5. SonarQube quality gate') {
            when {
                expression {
                    return params.RUN_SONAR &&
                        !params.SONAR_GATE_VIA_SCANNER
                }
            }

            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        writeFile(
                            file: 'reports/sonar-quality-gate.txt',
                            text: "quality_gate=${qg.status}\nbuild=${env.BUILD_NUMBER}\ntime=${new Date().format("yyyy-MM-dd'T'HH:mm:ssZ")}\n"
                        )

                        if (qg.status != 'OK') {
                            error(
                                "SonarQube quality gate failed: ${qg.status}"
                            )
                        }

                        echo "SonarQube quality gate: ${qg.status}"
                    }
                }
            }
        }

        stage('6. Build Docker images as tekuser') {
            steps {
                sh '''
                    set -eu

                    sudo -n -u tekuser \
                        "$SECUREASSIST_HELPER" build "$WORKSPACE" \
                        > reports/images.txt 2>&1 || {
                            cat reports/images.txt
                            echo "FAIL: Docker image build failed"
                            exit 1
                        }

                    cat reports/images.txt
                '''
            }
        }

        stage('7. Load images into Minikube as tekuser') {
            steps {
                sh '''
                    set -eu

                    sudo -n -u tekuser \
                        "$SECUREASSIST_HELPER" load "$WORKSPACE" \
                        > reports/minikube-images.txt 2>&1 || {
                            cat reports/minikube-images.txt
                            echo "FAIL: Minikube image loading failed"
                            exit 1
                        }

                    cat reports/minikube-images.txt
                '''
            }
        }

        stage('8. Validate Kubernetes manifests as tekuser') {
            steps {
                sh '''
                    set -eu

                    sudo -n -u tekuser \
                        "$SECUREASSIST_HELPER" validate "$WORKSPACE" \
                        > reports/manifest-validation.txt 2>&1 || {
                            cat reports/manifest-validation.txt
                            echo "FAIL: Kubernetes manifest validation failed"
                            exit 1
                        }

                    cat reports/manifest-validation.txt
                '''
            }
        }

        stage('9. Deploy to Minikube as tekuser') {
            when {
                expression { return params.DEPLOY }
            }

            steps {
                sh '''
                    set -eu

                    sudo -n -u tekuser \
                        "$SECUREASSIST_HELPER" deploy "$WORKSPACE" \
                        > reports/k8s-status.txt 2>&1 || {
                            cat reports/k8s-status.txt
                            echo "FAIL: SecureAssist deployment failed"
                            exit 1
                        }

                    cat reports/k8s-status.txt
                '''
            }
        }

        stage('10. Deployment and health checks') {
            when {
                expression { return params.DEPLOY }
            }

            steps {
                sh '''
                    set -eu

                    sudo -n -u tekuser \
                        "$SECUREASSIST_HELPER" verify "$WORKSPACE" \
                        > reports/verification.txt 2>&1 || {
                            cat reports/verification.txt
                            echo "FAIL: deployment verification failed"
                            exit 1
                        }

                    cat reports/verification.txt
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/**',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }

        success {
            echo 'SecureAssist pipeline PASSED. Evidence is archived under Build Artifacts.'
        }

        failure {
            echo 'SecureAssist pipeline FAILED. Inspect the first failed stage and its archived reports.'
        }
    }
}
